<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Twitter</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>TWITTER POSTS</h1>
    <% for (post of posts) {%>
        <div class="post">
            <h3 class="user">@<%= post.username%></h3>
            <h4 class="content"><%= post.content%></h4>
            <button class="likes"><%= post.likes%></button>
            <button class="comments"><%= post.comments%></button>
            <a class="about" href ="http://localhost:3000/posts/<%= post.id %>">detailed info</a>
        </div>
    <%}%>
    <br>
    <br>
    <a href="http://localhost:3000/posts/new">Create new Post</a>
</body>
</html>