<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rolling Dice</title>
</head>
<body>
    <h1>Rolling Dice</h1>
    <h2>Your dice value is : <%= dicevalue %></h2>
